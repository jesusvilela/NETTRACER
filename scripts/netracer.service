[Unit]
Description=NETTRACER Topos Orchestration Broker & Substrate Supervisor
After=network.target

[Service]
Type=simple
User=netracer
WorkingDirectory=/opt/netracer
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
Environment=PORT=8787
# Bind to loopback; place a TLS reverse proxy in front for remote access.
Environment=HOST=127.0.0.1

# Security Sandboxing
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
